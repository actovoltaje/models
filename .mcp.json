{
  "mcpServers": {
    "playwright": {
      "command": "bash",
      "args": ["scripts/mcp/playwright.sh"]
    },
    "chrome-devtools": {
      "command": "bash",
      "args": ["scripts/mcp/chrome-devtools.sh"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-}"
      }
    }
  }
}
