# Claves de los motores. Opcionales en local: sin ellas se usan motores simulados.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Obligatorio en producción: firma de las tarjetas compartibles (cadena larga aleatoria).
CARD_SECRET=

# Tope global de escaneos gratuitos al día (por defecto 200). Ponlo según tu presupuesto en las APIs.
MAX_SCANS_PER_DAY=200

# En producción, sin claves reales la API responde 503. Solo para demos públicas con datos simulados:
ALLOW_SIMULATED_ENGINES=
